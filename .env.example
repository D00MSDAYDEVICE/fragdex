# ---------------------------------------------------------------------------
# Fragdex configuration. Copy to .env (deployfragdex.sh / deployfragdex.ps1 do this for you).
# After changing anything here run:  docker compose up -d
# ---------------------------------------------------------------------------

# Domain name or IP address people use to reach the site. No domain? Use the
# server's public IP (or LAN IP). Several are allowed, comma separated:
#   SITE_HOST=fragdex.example.com
#   SITE_HOST=203.0.113.10
#   SITE_HOST=203.0.113.10,192.168.1.50
SITE_HOST=

# Ports published on the host. Any free ports work, e.g. HTTPS_PORT=8443.
# Let's Encrypt must reach public port 80 (HTTP challenge) or 443 (TLS
# challenge) - if you change these, forward 80/443 to them or the app falls
# back to a self-signed certificate automatically.
HTTP_PORT=80
HTTPS_PORT=443

# auto     : Let's Encrypt for public domains AND public IPs (short-lived IP
#            certificates), self-signed for private IPs/LAN names, with an
#            automatic self-signed fallback if Let's Encrypt fails.
# internal : always self-signed (browser shows a warning once)
# custom   : use ./certs/cert.pem and ./certs/key.pem
# off      : plain HTTP only on HTTP_PORT (when another proxy does TLS)
TLS_MODE=auto

# Optional e-mail for Let's Encrypt expiry/problem notices.
ACME_EMAIL=

# First admin account, created on first start only. Leave the password empty
# to have a random one printed in the logs:  docker compose logs app
# Remove ADMIN_PASSWORD from this file after your first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional Steam Web API key (https://steamcommunity.com/dev/apikey) for
# avatars, current Steam names and VAC/game bans. Can also be set in the UI.
STEAM_API_KEY=
STEAM_REFRESH_HOURS=24

# Host folder that is scanned for new demos, logs, spreadsheets and .fdx
# scanner exports (mounted read-only). Defaults:
#   Linux hosts:    /home/demos   (deployfragdex.sh)
#   Windows hosts:  C:\demos      (deployfragdex.ps1)
HOST_WATCH_DIR=/home/demos
WATCH_INTERVAL=60

# Max size of one upload request in MB (zip up big demo batches).
MAX_UPLOAD_MB=1024
# Keep uploaded files in the data volume after importing them.
KEEP_UPLOADS=false

# IPs used by more than this many Steam IDs (VPNs, LAN centres, CGNAT) are not
# used to link alt accounts. 0 = no limit.
ALT_IP_MAX_ACCOUNTS=10

# How long a login lasts, in days.
SESSION_DAYS=7
